# ---------------------------------------------------------------------------
# Build output
#
# build/ is the CMake binary directory. It is machine-specific (it bakes in
# absolute paths and the compiler's identity), so it must never be committed --
# and FetchContent unpacks ImGui, ImPlot and lazycsv into build/_deps/, which
# would otherwise add a large vendored tree to every diff.
# ---------------------------------------------------------------------------
/build/
build/
cmake-build-*/

# ---------------------------------------------------------------------------
# CMake scratch files (in case someone configures in-tree by accident)
# ---------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# ---------------------------------------------------------------------------
# Compiled artifacts
# ---------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.exe
*.dll

# ---------------------------------------------------------------------------
# Editor / IDE
# ---------------------------------------------------------------------------
.vscode/ipch/
.cache/
*.cache/
